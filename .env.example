# SettleWise environment configuration.
# The app runs in demo mode by default (no external services required).
# Set DEMO_MODE=false and provide the SQL_* values below to use persistent PostgreSQL.

# Demo mode: true runs on an in-memory PostgreSQL (PGLite) seeded with demo data.
# Recommended for local development. On Vercel this is always enabled.
DEMO_MODE=true

# --- Persistent PostgreSQL (only needed when DEMO_MODE=false) ---
# Host of the PostgreSQL server (for example a Google Cloud SQL public IP).
SQL_HOST=
# Database name.
SQL_DB_NAME=
# Connecting user and password.
SQL_USER=
SQL_PASSWORD=
# Admin credentials used by drizzle-kit migrations.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Public URL of the deployed app (used for self-referential links).
# Optional.
APP_URL=
